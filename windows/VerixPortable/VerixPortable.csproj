<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VERIX</AssemblyName>
    <RootNamespace>VerixPortable</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableDefaultItems>true</EnableDefaultItems>
    <V2AssetsRoot>$(MSBuildProjectDirectory)\..\..\dist-v2\</V2AssetsRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <None Update="Run-V2-Local.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(V2AssetsRoot)index.html')">
    <Content Include="$(V2AssetsRoot)**\*">
      <Link>v2-assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>v2-assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateV2AssetsForPublish" BeforeTargets="PrepareForPublish">
    <Error
      Condition="!Exists('$(V2AssetsRoot)index.html')"
      Text="V2 local assets are missing at $(V2AssetsRoot). Run npm ci and npm run build:v2 before publishing the Windows package." />
  </Target>
</Project>
